{
  "name": "Trello",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/numeral": "^2.0.5",
    "@types/uuid": "^11.0.0",
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.3.1",
    "@mui/x-data-grid": "^9.12.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "gantt-task-react": "^0.3.9",
    "lucide-react": "^1.34.0",
    "numeral": "^2.0.6",
    "postcss": "^8.5.26",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "redux-persist": "^6.0.0",
    "tailwindcss": "^4.3.3"
  }
}
