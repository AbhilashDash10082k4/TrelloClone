// Prisma schema for Trello clone database

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// User roles in system & organizations
enum UserRole {
  ADMIN
  MEMBER
}

// Default section status states
enum SectionTitle {
  UPCOMING
  IN_PROGRESS
  DONE
}

// User entity
model User {
  id               String        @id @default(cuid())
  name             String?
  email            String        @unique
  role             UserRole      @default(MEMBER)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  orgMemberships   OrgMember[]
  boardMemberships BoardMember[]
  taskMappings     TaskMapping[]
  comments         Comment[]
}

// Organization entity
model Org {
  id          String      @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  members     OrgMember[]
  projects    Project[]
}

// Organization membership join table
model OrgMember {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      UserRole @default(MEMBER)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

// Project entity within an Organization
model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  orgId       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  boards      Board[]
}

// Board entity within a Project
model Board {
  id          String        @id @default(cuid())
  title       String
  description String?
  projectId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members     BoardMember[]
  sections    Section[]
  tasks       Task[]
}

// Board membership join table
model BoardMember {
  id        String   @id @default(cuid())
  userId    String
  boardId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([userId, boardId])
}

// Task column section in board
model Section {
  id        String       @id @default(cuid())
  title     SectionTitle @default(UPCOMING)
  boardId   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  board     Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

// Task item entity
model Task {
  id           String        @id @default(cuid())
  title        String
  description  String?
  boardId      String
  sectionId    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  board        Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  section      Section       @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  taskMappings TaskMapping[]
  comments     Comment[]
}

// Many-to-many mapping between users and assigned tasks
model TaskMapping {
  id        String   @id @default(cuid())
  userId    String
  taskId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
}

// Task comments
model Comment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
