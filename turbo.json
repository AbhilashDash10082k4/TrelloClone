{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["DATABASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^contract:emit"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types", "^contract:emit"]
    },
    "dev": {
      "dependsOn": ["^contract:emit"],
      "cache": false,
      "persistent": true
    },
    "contract:emit": {
      "inputs": ["src/prisma/contract.prisma", "prisma.config.ts"],
      "outputs": ["src/prisma/contract.json", "src/prisma/contract.d.ts"]
    },
    "migration:plan": {
      "dependsOn": ["contract:emit"],
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
